<div>
  <table>
    <thead>
      <tr>
        <th>RFC</th>
        <th>Nombre</th>
        <th>Movimiento</th>
        <th>Tipo contratacion</th>
        <th>Cuenta</th>
        <th>Fecha inicio</th>
        <th>Adscripcion</th>
        <th>Clave pres.</th>
        <th>Comisionado a</th>
      </tr>
    </thead>
    <tbody>
      <% @movements.each do |movement| %>
        <tr>
          <td><%= movement.rfc %></td>
          <td><%= movement.name %></td>
          <td><%= movement.movement_type %></td>
          <td><%= movement.place_type %></td>
          <td><%= movement.account_type %></td>
          <td><%= movement.start_date %></td>
          <td><%= movement.adscription %></td>
          <td><%= movement.budget_key %></td>
          <td><%= movement.comissioned_to %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

